# Backend listen port (Render will inject PORT automatically)
PORT=3000

# Optional persistent data directory for SQLite and JSON fallback files
DATA_DIR="./data"

# Trusted frontend origins allowed to call the Render backend
CORS_ALLOWED_ORIGINS="http://localhost:3000,https://your-site.netlify.app"

# Server-side Eton webhook endpoint (must stay on chat-room.eton.vn)
ETON_WEBHOOK_URL="https://chat-room.eton.vn/hooks/YOUR_WEBHOOK_TOKEN"

# Frontend API base URL.
# Leave empty for same-origin local development.
# Example for Netlify -> Render split deploy:
# VITE_API_BASE_URL="https://your-render-service.onrender.com"
VITE_API_BASE_URL=""

# Face recognition provider: local | google | auto
FACE_RECOGNITION_PROVIDER="local"

# Local model name shown in API status / logs
LOCAL_FACE_RECOGNITION_MODEL="local-exact-match"

# Optional on-prem/local inference service endpoint
LOCAL_FACE_RECOGNITION_URL="http://127.0.0.1:8000/recognize"

# Optional Google fallback configuration when provider=google or auto
GEMINI_API_KEY="MY_GEMINI_API_KEY"
GOOGLE_GEMINI_MODEL="gemini-3.8-flash"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"
