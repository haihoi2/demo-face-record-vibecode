# Backend listen port (Render will inject PORT automatically)
PORT=3000

# Optional persistent data directory for SQLite and JSON fallback files
DATA_DIR="./data"

# Trusted frontend origins allowed to call the Render backend
# Host port the app is published on. The container always listens on 3000
# internally; this only changes the published host port.
APP_PORT=8080

# Local dev domain gate-watch.vota.local requires a hosts entry:
#   127.0.0.1 gate-watch.vota.local
# The bare origin (no port) is for a future nginx reverse proxy on port 80.
CORS_ALLOWED_ORIGINS="http://localhost:8080,http://127.0.0.1:8080,http://gate-watch.vota.local:8080,http://gate-watch.vota.local,http://192.168.6.52:8080,https://stg-gate-watch.vota.vn"

# Server-side Eton webhook endpoint (must stay on chat-room.eton.vn)
ETON_WEBHOOK_URL="https://chat-room.eton.vn/hooks/YOUR_WEBHOOK_TOKEN"

# Frontend API base URL.
# Leave empty for same-origin local development.
# Example for Netlify -> Render split deploy:
# VITE_API_BASE_URL="https://your-render-service.onrender.com"
VITE_API_BASE_URL=""

# Face recognition provider: local | google | auto
FACE_RECOGNITION_PROVIDER="local"

# Local model name shown in API status / logs
LOCAL_FACE_RECOGNITION_MODEL="local-exact-match"

# Optional on-prem/local inference service endpoint
LOCAL_FACE_RECOGNITION_URL="http://127.0.0.1:8000/recognize"

# Optional Google fallback configuration when provider=google or auto
GEMINI_API_KEY="MY_GEMINI_API_KEY"
GOOGLE_GEMINI_MODEL="gemini-3.8-flash"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# =============================================================================
# CẤU HÌNH DATABASE POSTGRESQL 18 & SQLITE
# =============================================================================
#
# Tùy chọn A: Dùng PostgreSQL 18 chạy qua Docker Container (docker compose up -d)
#   POSTGRES_IMAGE="postgres:18-alpine"
#   POSTGRES_USER="smartface_user"
#   POSTGRES_PASSWORD="smartface_secret_pass"
#   POSTGRES_DB="smartface_db"
#   POSTGRES_PORT=5432
#   DATABASE_URL="postgresql://smartface_user:smartface_secret_pass@postgres:5432/smartface_db"
#
# Tùy chọn B: Dùng PostgreSQL 18 CÓ SẴN TRÊN MÁY CỤC BỘ (Host OS / localhost)
#   (Chạy container: docker compose up -d --build smartface-app)
#   DATABASE_URL="postgresql://postgres:mat_khau_postgres_cua_ban@host.docker.internal:5432/smartface_db"
#
# Tùy chọn C: Không dùng PostgreSQL, chạy độc lập siêu nhẹ bằng SQLite (data/smartface.db)
#   (Để trống DATABASE_URL)
POSTGRES_IMAGE="postgres:18-alpine"
POSTGRES_USER="smartface_user"
POSTGRES_PASSWORD="smartface_secret_pass"
POSTGRES_DB="smartface_db"
POSTGRES_PORT=5432
DATABASE_URL="postgresql://smartface_user:smartface_secret_pass@postgres:5432/smartface_db"
