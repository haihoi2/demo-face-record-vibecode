# Backend listen port (Render will inject PORT automatically)
PORT=3000

# Optional persistent data directory for SQLite and JSON fallback files
DATA_DIR="./data"

# Trusted frontend origins allowed to call the Render backend
# Host port the app is published on. The container always listens on 3000
# internally; this only changes the published host port.
APP_PORT=8080

# uid/gid the app process runs as INSIDE the container (Dockerfile build args,
# forwarded by docker-compose.yml). ./data is bind-mounted into the container,
# so set these to the host user that owns ./data - `id -u` and `id -g` - or
# SQLite fails with "attempt to write a readonly database" and the JSON
# fallback save fails silently. Default 1000 = the stock `node` user.
# Changing them requires a rebuild: docker compose up -d --build
APP_UID=1000
APP_GID=1000

# Local dev domain gate-watch.vota.local requires a hosts entry:
#   127.0.0.1 gate-watch.vota.local
# The bare origin (no port) is for a future nginx reverse proxy on port 80.
CORS_ALLOWED_ORIGINS="http://localhost:8080,http://127.0.0.1:8080,http://gate-watch.vota.local:8080,http://gate-watch.vota.local,http://192.168.6.52:8080,https://stg-gate-watch.vota.vn"

# Server-side Eton webhook endpoint (must stay on chat-room.eton.vn)
ETON_WEBHOOK_URL="https://chat-room.eton.vn/hooks/YOUR_WEBHOOK_TOKEN"

# Frontend API base URL.
# Leave empty for same-origin local development.
# Example for Netlify -> Render split deploy:
# VITE_API_BASE_URL="https://your-render-service.onrender.com"
VITE_API_BASE_URL=""

# Simulation shortcuts for demos. When true, /api/recognize-face accepts a
# testEmployeeId / employeeCode with NO image and reports a successful
# recognition, which unlocks the door. Leave false anywhere a real lock is
# attached - it is a remote unlock bypass by design.
ALLOW_SIMULATED_RECOGNITION="false"
ENABLE_DEMO_DATA="false"
VITE_ENABLE_DEMO_OFFLINE_PERSISTENCE="false"

# Gate camera sources. The built-in gate defaults are EMPTY on purpose: an RTSP
# URL carries the camera account, so it belongs here and never in tracked source.
# Leave unset to configure the gates through the UI instead.
#   CAMERA_ENTRY_RTSP_URL="rtsp://<user>:<pass>@<host>:554/Streaming/Channels/101"
CAMERA_ENTRY_RTSP_URL=""
CAMERA_EXIT_RTSP_URL=""

# Face recognition provider: local | google | auto
FACE_RECOGNITION_PROVIDER="local"

# Local model name shown in API status / logs
LOCAL_FACE_RECOGNITION_MODEL="local-exact-match"

# Optional on-prem/local inference service endpoint
LOCAL_FACE_RECOGNITION_URL="http://127.0.0.1:8000/recognize"

# Optional Google fallback configuration when provider=google or auto
GEMINI_API_KEY="MY_GEMINI_API_KEY"
GOOGLE_GEMINI_MODEL="gemini-3.8-flash"

# APP_URL: public URL where this app is reachable, e.g. https://stg-gate-watch.vota.vn
# Used to build the click-through link in stranger-alert webhooks
# (<APP_URL>/#strangers/<logId>). Leave empty to derive it from the request
# (X-Forwarded-Proto/Host behind the nginx edge). The literal "MY_APP_URL" is
# treated as unset.
APP_URL=""

# Operator authorization for biometric images and stranger adjudication.
# Generate long random values outside source control. The UI exchanges the token
# for a short-lived HttpOnly cookie and never stores the token in browser storage.
# Production biometric endpoints fail closed when OPERATOR_ID/TOKEN are unset.
OPERATOR_ID=""
OPERATOR_TOKEN=""
OPERATOR_SESSION_SECRET=""
# Set true only for a split-site operator UI over HTTPS. This emits
# SameSite=None; Secure; the server refuses cross-site cookies outside production.
OPERATOR_COOKIE_CROSS_SITE="false"
# Optional read-only principal for viewing clusters/images without mutation rights.
VIEWER_ID=""
VIEWER_TOKEN=""
DEVICE_INGEST_TOKEN=""
INTERNAL_API_TOKEN=""

# =============================================================================
# CẤU HÌNH DATABASE POSTGRESQL 18 & SQLITE
# =============================================================================
#
# Tùy chọn A: Dùng PostgreSQL 18 chạy qua Docker Container (docker compose up -d)
#   POSTGRES_IMAGE="postgres:18-alpine"
#   POSTGRES_USER="smartface_user"
#   POSTGRES_PASSWORD="smartface_secret_pass"
#   POSTGRES_DB="smartface_db"
#   POSTGRES_PORT=5432
#   DATABASE_URL="postgresql://smartface_user:smartface_secret_pass@postgres:5432/smartface_db"
#
# Tùy chọn B: Dùng PostgreSQL 18 CÓ SẴN TRÊN MÁY CỤC BỘ (Host OS / localhost)
#   (Chạy container: docker compose up -d --build smartface-app)
#   DATABASE_URL="postgresql://postgres:mat_khau_postgres_cua_ban@host.docker.internal:5432/smartface_db"
#
# Tùy chọn C: Không dùng PostgreSQL, chạy độc lập siêu nhẹ bằng SQLite (data/smartface.db)
#   (Để trống DATABASE_URL)
POSTGRES_IMAGE="postgres:18-alpine"
POSTGRES_USER="smartface_user"
POSTGRES_PASSWORD="smartface_secret_pass"
POSTGRES_DB="smartface_db"
POSTGRES_PORT=5432
DATABASE_URL="postgresql://smartface_user:smartface_secret_pass@postgres:5432/smartface_db"

# Minimum capture quality (0-1) for STORING a stranger snapshot. Access
# decisions are unaffected - this only stops unidentifiable images from
# filling the cluster panel. Set 0 to store every detected face.
FACE_STRANGER_MIN_QUALITY="0.25"

# Minimum face size, in pixels (shorter side of the face box in the camera
# frame). Smaller faces are too far from the gate: never recognised, tracked or
# stored. 60 = only people close to the gate. Recognition itself still works
# down to ~40 px on this site's 4K camera; lower this to recognise from further.
FACE_MIN_SIZE_PX="60"
# A stranger is stored and grouped only from this size up; smaller unknown
# faces are too far away for an operator to identify. Employees between the
# two floors are still recognised. Set 0 to store every stranger face.
FACE_STRANGER_MIN_SIZE_PX="60"

# JPEG qscale for the photo stored with each access log (FFmpeg -q:v; 2 = best
# and largest, 31 = smallest). Full resolution is kept; only compression
# changes. 8 is ~2.3x smaller than the camera frame with no measured loss of
# face detection or enrolment quality. Recognition always uses the original.
SNAPSHOT_JPEG_QSCALE="8"

# Optional: keep the database and app data on another disk (absolute host
# paths). Unset = the named Docker volume and ./data, as before.
# SMARTFACE_PG_DATA=/data/smartface/postgres18
# SMARTFACE_DATA_DIR=/data/smartface/app-data

# NVR playback ("Đoạn ghi" button in access history). The backend fetches the
# recording around an event from the NVR and streams it to the browser; the
# address and login never leave the server. Bare rtsp:// origin, no path.
# Channels are the NVR's recording tracks per gate (they can differ from the
# stream the gate is watched from). Unset = button hidden.
RECORDING_NVR_URL=""
RECORDING_ENTRY_CHANNEL=""
RECORDING_EXIT_CHANNEL=""
# Simultaneous playbacks (each holds one NVR session and ~1 CPU core).
RECORDING_MAX_CONCURRENT="2"

